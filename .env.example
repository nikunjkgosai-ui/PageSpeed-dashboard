# Path to your service account JSON file (for GA4 & Search Console)
SERVICE_ACCOUNT_FILE=./service-account.json

# PageSpeed Insights API key (or use same service account project API key)
PAGESPEED_API_KEY=YOUR_PAGESPEED_API_KEY

# Optional: default GA4 property id and site url
GA4_PROPERTY_ID=YOUR_GA4_PROPERTY_ID
SITE_URL=https://www.example.com
